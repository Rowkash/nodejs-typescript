{
  "name": "node-typescript-template",
  "version": "1.0.0",
  "description": "Node.js template with TypeScript, Eslint and Prettier",
  "author": "Ruslan Hamzin",
  "license": "MIT",
  "scripts": {
    "start:dev": "tsx --env-file=.env --watch ./src/main.ts",
    "start:prod": "node dist/main.js",
    "type:check": "tsc --noEmit --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
